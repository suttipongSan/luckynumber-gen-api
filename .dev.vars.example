# Copy to .dev.vars for `wrangler dev`. In production set each of these with
#   npx wrangler secret put <NAME>
# (WEB_URL and COOKIE_SECURE are plain vars in wrangler.toml; .dev.vars overrides them locally.)

# The database is the D1 binding `DB` in wrangler.toml; `wrangler dev` uses a local copy
# (npm run db:migrate && npm run seed). No database variables are needed here.

# HMAC key for session cookies (ng_session / ng_admin). Any long random string, e.g.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-long-random-string

# HMAC key for signed asset URLs (/assets/:id?exp=&sig=). Long random string, different from above.
ASSET_SIGNING_SECRET=change-me-another-long-random-string

# Back office login.
ADMIN_USERNAME=admin
# PBKDF2 hash from `npm run hash-password -- <password>` (e.g. for admin1234 in local dev).
# Keep it in single quotes.
ADMIN_PASSWORD_HASH='pbkdf2$100000$<salt-base64>$<hash-base64>'

# Origin of the web app (used for CORS and for member links ${WEB_URL}/m/<linkToken>).
WEB_URL=http://localhost:5173

# 'true' in production (Secure; SameSite=None cookies), 'false' for local http dev (SameSite=Lax).
COOKIE_SECURE=false

# Web Push for the daily reminders. `npm run vapid:generate` prints a key pair (it writes no file).
# In production set both with `npx wrangler secret put <NAME>`. Without both keys the reminders are off:
# GET /push/key answers 503 and the cron trigger does nothing.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# Optional contact for the push services (mailto: or https: URL). Default: https://pnphoto.co
# VAPID_SUBJECT=mailto:you@example.com
