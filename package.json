{
  "name": "numbergen-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8787",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply numbergen --local",
    "seed": "tsx scripts/seed-sql.ts --demo && wrangler d1 execute numbergen --local --file seed.sql",
    "hash-password": "tsx scripts/hash-password.ts",
    "vapid:generate": "tsx scripts/vapid-generate.ts",
    "predeploy": "npm run db:migrate:remote",
    "deploy": "wrangler deploy",
    "db:migrate:remote": "wrangler d1 migrations apply numbergen --remote",
    "seed:remote": "tsx scripts/seed-sql.ts && wrangler d1 execute numbergen --remote --file seed.sql"
  },
  "dependencies": {
    "@libsql/client": "0.18.0",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.13",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "drizzle-kit": "0.31.11",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "4.1.12",
    "wrangler": "4.152.0"
  }
}
